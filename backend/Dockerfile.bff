# ==========================================
# Стейдж 1: Сборка TypeScript в JavaScript
# ==========================================
FROM node:20-alpine AS build
WORKDIR /app

# Копируем файлы зависимостей
COPY backend/package*.json ./

# Устанавливаем все зависимости (включая TypeScript для сборки)
RUN npm ci

# Копируем весь исходный код (папку src и конфиги)
COPY backend/tsconfig.json ./
COPY backend/src ./src

# Собираем проект (запускает tsc, который создаст server.js прямо в папке src)
RUN npm run build

# ==========================================
# Стейдж 2: Легковесный рантайм для работы
# ==========================================
FROM node:20-alpine
WORKDIR /app

# Ставим ТОЛЬКО production-зависимости (без тестов и TypeScript)
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Копируем скомпилированный JS (он лежит в папке src)
COPY --from=build /app/src ./src

# Запуск от непривилегированного пользователя (требование задачи)
USER node

EXPOSE 5000

# Запускаем сервер через скрипт из package.json
CMD ["npm", "start"]
