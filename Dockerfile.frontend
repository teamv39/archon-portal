# ==========================================
# Стейдж 1: Сборка фронтенда
# ==========================================
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ==========================================
# Стейдж 2: Раздача через Nginx
# ==========================================
FROM nginx:alpine

# Копируем наш конфиг
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Копируем статику
COPY --from=build /app/dist /usr/share/nginx/html

# ВАЖНО: Мы НЕ пишем USER nginx. 
# По умолчанию Nginx сам запустит воркеры от имени пользователя nginx, 
# как прописано в его стандартном конфиге.

EXPOSE 80